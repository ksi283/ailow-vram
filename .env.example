# ==================== Model ====================
# MODEL_ID chỉ để tham chiếu/truy vết, stack chạy bằng GGUF_REPO bên dưới.
MODEL_ID=xtools-at/DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic

# Bản GGUF quant của chính model đó (mradermacher quant từ repo MODEL_ID)
GGUF_REPO=mradermacher/DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic-GGUF

# Chọn quant (kèm vision mmproj Q8_0 ~0.58 GiB mọi bản):
#   IQ4_XS  = 4.87 GiB — tiết kiệm VRAM nhất, chất lượng giảm nhẹ
#   Q4_K_M  = 5.24 GiB — cân bằng tốt nhất (mặc định)
#   Q5_K_M  = 6.02 GiB — chất lượng cao hơn, 8GB VRAM sẽ rất chật
#   Q6_K    = 6.85 GiB / Q8_0 = 8.87 GiB — chỉ cho GPU > 10GB
QUANT=Q4_K_M

# Tên viết gọn khi gọi API
SERVED_MODEL_NAME=deepseek-v4-pro

# ==================== Server ====================
# Cổng truy cập từ máy host (8000 đang trống; tránh 8080 vì csy-media-engine dùng)
HOST_PORT=8000

# ==================== Open WebUI ====================
# Cổng giao diện chat (quản lý conversation theo project/folder)
# LUU Y: đụng cổng 3000 trên Windows đã bị một app Node.js chiếm → dùng 3001
WEBUI_PORT=3001
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Độ dài context theo tokens. 8GB VRAM (Q4_K_M + vision) đủ thoải mái cho 32768
# (~0.8GB KV cache); cần 64K+ thì giảm QUANT xuống IQ4_XS hoặc tắt vision.
CTX_SIZE=32768

# MiB VRAM giữ dự phòng khi llama-server tự cân chỉnh fit (thấp hơn mặc định
# 1024 để card 8GB offload hết được các layer)
FIT_TARGET=512

# Đổi sang CPU-only: đặt LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
# và xóa khối "devices" (GPU) trong docker-compose.yml
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# Đặt key bảo vệ API nếu bật dòng LLAMA_API_KEY trong docker-compose.yml
# API_KEY=sk-thay-key-cua-ban
